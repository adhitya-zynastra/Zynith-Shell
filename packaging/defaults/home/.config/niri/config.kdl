// ─────────────────────────────────────────────────────────────────────────────
//  niri — the Zynith default configuration
//  Installed once by zynith-firstrun (never overwritten). Edit freely: this file is yours.
//
//  config.kdl (this file: core settings)
//    → rice/layout.kdl, wallpaper.kdl, glass.kdl, animations.kdl, materials.kdl
//        generated by Zynith from your settings — do not edit by hand, Zynith rewrites them
//    → rice/rules.kdl   window and layer rules (yours)
//    → rice/binds.kdl   key bindings (yours)
//    → noctalia.kdl     colours from the wallpaper (generated by the Zynith shell; keep it last)
//
//  niri documentation: /usr/share/doc/niri/ and https://github.com/YaLTeR/niri/wiki
// ─────────────────────────────────────────────────────────────────────────────

// Zynith: the native shell (services, lock screen, wallpaper), supervised so it is relaunched if it dies, and the
// Zynith UI (bars, panels, launcher, notifications), supervised the same way.
spawn-at-startup "zynith-ui" "native" "supervise"
spawn-at-startup "zynith-ui" "start"

input {
    keyboard {
        xkb {
            // set by the installer for the installed system; change here for another layout
            layout "us"
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        dwt
        natural-scroll
    }

    // focus follows the pointer, but the strip never scrolls just because the pointer moved
    focus-follows-mouse max-scroll-amount="0%"

    // Mod drags: Mod+left-drag moves a window, Mod+right-drag resizes, Mod+middle-drag pans
    mod-key "Super"
}

// Outputs are configured automatically. To pin a mode, scale or rotation, add an output block, e.g.:
// output "eDP-1" {
//     mode "2560x1600@240"
//     scale 1.25
// }
// (Settings → Displays edits the rotation here for you, with a backup.)

layout {
    gaps 15
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    // a thin accent edge instead of a thick ring; colours come from noctalia.kdl
    focus-ring {
        off
    }
    border {
        width 1
    }

    shadow {
        on
        softness 28
        spread 2
        offset x=0 y=8
        color "#0000009a"
        inactive-color "#00000055"
    }

    tab-indicator {
        width 3
        gap 6
        length total-proportion=0.6
        position "top"
        gaps-between-tabs 4
        corner-radius 2
    }
}

// Window behaviour preset (Settings → Window), generated by Zynith after the layout block above.
include "rice/layout.kdl"
// Overview wallpaper (Settings → Wallpaper), generated by Zynith.
include "rice/wallpaper.kdl"
// The one global blur node, generated by Zynith from the glass settings; do not add another blur block.
include "rice/glass.kdl"

overview {
    zoom 0.42
    backdrop-color "#0b0c10"
    workspace-shadow {
        softness 60
        spread 12
        offset x=0 y=18
        color "#00000080"
    }
}

// Motion (Settings → Animation), generated by Zynith.
include "rice/animations.kdl"

prefer-no-csd

cursor {
    hide-when-typing
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "rice/rules.kdl"
// Surface materials (Settings → Appearance), generated by Zynith.
include "rice/materials.kdl"
include "rice/binds.kdl"

// Colours from the wallpaper, generated by the Zynith shell — keep last so it wins.
include "noctalia.kdl"
