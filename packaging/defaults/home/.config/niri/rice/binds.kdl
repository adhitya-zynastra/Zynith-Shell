// ─────────────────────────────────────────────────────────────────────────────
//  Key bindings — the Zynith defaults. Yours to edit: zynith-firstrun never overwrites this file.
//  Mod is Super. Mod+H shows them all.
//  Shell commands go through `zynith-ui cmd` (the Zynith UI, falling back to the native shell's own panel when the UI
//  is not running) or the native shell's IPC (`zynith-shell msg …`, its command name), so they get OSDs and theming.
//  repeat=false on shell commands: a held key would otherwise repeat them ~50 times a second.
// ─────────────────────────────────────────────────────────────────────────────

binds {
    // ── Help ────────────────────────────────────────────────────────────────
    Mod+H           hotkey-overlay-title="Key bindings" { show-hotkey-overlay; }
    Mod+Shift+Slash hotkey-overlay-title=null { show-hotkey-overlay; }

    // ── Apps ────────────────────────────────────────────────────────────────
    Mod+Return       hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+Shift+Return hotkey-overlay-title="Drop-down terminal" { spawn "kitty" "--class" "dropterm"; }
    Mod+B            hotkey-overlay-title="Browser" { spawn "firefox"; }
    Mod+E            hotkey-overlay-title="Files" { spawn "thunar"; }

    // ── Zynith ──────────────────────────────────────────────────────────────
    Mod+D repeat=false       hotkey-overlay-title="App launcher" { spawn "zynith-ui" "cmd" "launcher"; }
    Mod+Alt+E repeat=false   hotkey-overlay-title="Emoji picker" { spawn "zynith-ui" "cmd" "launcher" ":"; }
    Mod+Alt+V repeat=false   hotkey-overlay-title="Clipboard history" { spawn "zynith-ui" "cmd" "clipboard"; }
    Mod+W repeat=false       hotkey-overlay-title="Wallpapers" { spawn "zynith-ui" "cmd" "wallpaper"; }
    Ctrl+Alt+W repeat=false  hotkey-overlay-title="Random wallpaper" { spawn "zynith-shell" "msg" "wallpaper-random"; }
    Mod+Shift+E repeat=false hotkey-overlay-title="Control Panel" { spawn "zynith-ui" "cmd" "control"; }
    Mod+Shift+N repeat=false hotkey-overlay-title="Notifications" { spawn "zynith-ui" "cmd" "notifications"; }
    Mod+T repeat=false       hotkey-overlay-title="Settings" { spawn "zynith-ui" "settings"; }
    Mod+N repeat=false       hotkey-overlay-title="Night light" { spawn "zynith-shell" "msg" "nightlight-force-toggle"; }
    Mod+Ctrl+S repeat=false  hotkey-overlay-title="Window switcher" { spawn "zynith-shell" "msg" "window-switcher"; }
    Mod+Alt+W repeat=false   hotkey-overlay-title="Edit desktop widgets" { spawn "zynith-ui" "cmd" "desktop-edit"; }

    // ── Session ─────────────────────────────────────────────────────────────
    Ctrl+Alt+L repeat=false  hotkey-overlay-title="Lock screen" { spawn "zynith-shell" "msg" "session" "lock"; }
    Ctrl+Alt+P repeat=false  hotkey-overlay-title="Power menu" { spawn "zynith-ui" "cmd" "session"; }
    Ctrl+Alt+Delete          hotkey-overlay-title="Log out" { quit; }
    Mod+Alt+R                hotkey-overlay-title="Reload niri and shell configuration" { spawn-sh "niri msg action load-config-file; zynith-shell msg config-reload"; }
    // recovery: restart the native shell and the Zynith UI (each waited out before its replacement starts)
    Mod+Ctrl+Alt+R repeat=false hotkey-overlay-title="Restart the shell" { spawn-sh "zynith-ui native restart; zynith-ui restart"; }
    Mod+Shift+P   hotkey-overlay-title="Monitors off" { power-off-monitors; }
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Toggle shortcut inhibit" { toggle-keyboard-shortcuts-inhibit; }

    // ── Windows ─────────────────────────────────────────────────────────────
    Mod+Q repeat=false hotkey-overlay-title="Close window" { close-window; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+F       hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+M       hotkey-overlay-title="Maximize to edges" { maximize-window-to-edges; }
    Mod+Alt+F   hotkey-overlay-title="Fill free width" { expand-column-to-available-width; }

    Mod+Space     hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+Alt+Space hotkey-overlay-title="Focus floating ↔ tiling" { switch-focus-between-floating-and-tiling; }
    Mod+C         hotkey-overlay-title="Center column" { center-column; }
    Mod+R         hotkey-overlay-title="Cycle column width" { switch-preset-column-width; }
    Mod+Shift+R   hotkey-overlay-title=null { switch-preset-column-width-back; }
    Mod+Ctrl+R    hotkey-overlay-title=null { reset-window-height; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    Mod+Shift+Left  { set-column-width "-5%"; }
    Mod+Shift+Right { set-column-width "+5%"; }
    Mod+Shift+Up    { set-window-height "-5%"; }
    Mod+Shift+Down  { set-window-height "+5%"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // tabbed columns
    Mod+G            hotkey-overlay-title="Tabbed column" { toggle-column-tabbed-display; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // ── Workspaces ──────────────────────────────────────────────────────────
    Mod+A repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Tab       hotkey-overlay-title="Next workspace" { focus-workspace-down; }
    Mod+Shift+Tab hotkey-overlay-title="Previous workspace" { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // ── Screenshots ─────────────────────────────────────────────────────────
    Print       hotkey-overlay-title="Screenshot (region)" { screenshot; }
    Mod+Print   hotkey-overlay-title="Screenshot (screen)" { spawn-sh "niri msg action screenshot-screen; pw-play --volume=0.5 /usr/share/zynith/sounds/screenshot.wav"; }
    Alt+Print   hotkey-overlay-title="Screenshot (window)" { spawn-sh "niri msg action screenshot-window; pw-play --volume=0.5 /usr/share/zynith/sounds/screenshot.wav"; }
    Mod+Shift+S repeat=false hotkey-overlay-title="Screenshot + annotate" { spawn "zynith-shell" "msg" "screenshot-annotate"; }

    // ── Hardware keys (with on-screen indicators) ───────────────────────────
    XF86AudioRaiseVolume allow-when-locked=true cooldown-ms=50 { spawn "zynith-shell" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true cooldown-ms=50 { spawn "zynith-shell" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true repeat=false { spawn "zynith-shell" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true repeat=false { spawn "zynith-shell" "msg" "mic-mute"; }

    XF86AudioPlay  allow-when-locked=true repeat=false { spawn "zynith-shell" "msg" "media" "toggle"; }
    XF86AudioPause allow-when-locked=true repeat=false { spawn "zynith-shell" "msg" "media" "toggle"; }
    XF86AudioStop  allow-when-locked=true repeat=false { spawn "zynith-shell" "msg" "media" "stop"; }
    XF86AudioNext  allow-when-locked=true repeat=false { spawn "zynith-shell" "msg" "media" "next"; }
    XF86AudioPrev  allow-when-locked=true repeat=false { spawn "zynith-shell" "msg" "media" "previous"; }

    XF86MonBrightnessUp   allow-when-locked=true cooldown-ms=50 { spawn "zynith-ui" "cmd" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true cooldown-ms=50 { spawn "zynith-ui" "cmd" "brightness" "down"; }
    XF86KbdBrightnessUp   allow-when-locked=true cooldown-ms=50 { spawn "zynith-shell" "msg" "keyboard-backlight-up"; }
    XF86KbdBrightnessDown allow-when-locked=true cooldown-ms=50 { spawn "zynith-shell" "msg" "keyboard-backlight-down"; }

    XF86Sleep { spawn "zynith-shell" "msg" "session" "lock-and-suspend"; }
}
