pragma Singleton

import QtQuick
import Quickshell
import Zynith.Native

// wallpaper.toml overview = live | poster → ~/.config/niri/rice/wallpaper.kdl. Live puts the running live
// wallpaper inside niri's overview backdrop (above the blurred poster, which still shows when no live wallpaper
// runs) and makes workspace backgrounds transparent so the desktop shows it too. Poster writes an empty
// fragment. Only the main UI instance writes.
Singleton {
    id: root

    property bool writer: false
    readonly property string mode: Config.wallpaper.overview === "live" ? "live" : "poster"
    readonly property bool included: NiriConfig.isIncluded("wallpaper")
    property string status: ""

    readonly property string header: "// Generated by Zynith from ~/.config/zynith/wallpaper.toml (overview = \"%1\"). Edits here are overwritten.\n"
    readonly property string live: "layer-rule {\n    match namespace=\"^linux-wallpaperengine$\"\n    place-within-backdrop true\n}\nlayout {\n    background-color \"transparent\"\n}\n"

    function apply(): void {
        if (!writer || !Config.loaded)
            return;
        NiriConfig.apply("wallpaper", header.arg(mode) + (mode === "live" ? live : "// The overview shows the blurred poster (rice/rules.kdl, noctalia-backdrop).\n"));
    }
    onModeChanged: apply()
    onWriterChanged: apply()
    readonly property Connections loaded: Connections {
        target: Config
        function onLoadedChanged(): void {
            root.apply();
        }
    }
    readonly property Connections result: Connections {
        target: NiriConfig
        function onApplied(name: string, ok: bool, message: string): void {
            if (name === "wallpaper")
                root.status = ok ? "" : message;
        }
    }
}
