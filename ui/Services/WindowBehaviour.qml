pragma Singleton

import QtQuick
import Quickshell
import Zynith.Native

// Turns window.behaviour into ~/.config/niri/rice/layout.kdl. niri lays windows out as scrollable columns;
// the presets only tune those columns. Nothing here resizes windows at run time. Only the main UI instance
// writes (`writer`); Settings changes shell.json and the main instance follows.
Singleton {
    id: root

    property bool writer: false
    readonly property string behaviour: Config.window.behaviour
    readonly property bool included: NiriConfig.isIncluded("layout")
    property string status: ""

    readonly property string header: "// Generated by Zynith from ~/.config/zynith/shell.json (window.behaviour = \"%1\").\n// Edits here are overwritten; choose a behaviour in Zynith Settings → Window behaviour.\n"

    readonly property var fragments: ({
            "config": "// Empty on purpose: the layout block in config.kdl applies as written.\n",
            "scrolling": "// Windows open at the width they ask for; the view scrolls and centres the focused column\n// when it does not fit.\nlayout {\n    default-column-width {}\n    center-focused-column \"on-overflow\"\n    always-center-single-column false\n}\n",
            "tiling-like": "// New windows take half the screen, so two share it side by side. Existing windows are never\n// resized to make room: a third window scrolls the strip.\nlayout {\n    default-column-width { proportion 0.5; }\n    preset-column-widths {\n        proportion 0.33333\n        proportion 0.5\n        proportion 0.66667\n        proportion 1.0\n    }\n    center-focused-column \"never\"\n    always-center-single-column\n}\n// expand is Mod+Alt+F and centring one column Mod+C in binds.kdl; this adds centring what is visible\nbinds {\n    Mod+Ctrl+C hotkey-overlay-title=\"Center visible columns\" { center-visible-columns; }\n}\n"
        })

    function text(key: string): string {
        return header.arg(key) + (fragments[key] ?? fragments["config"]);
    }

    function apply(): void {
        if (!writer || !Config.loaded)
            return;
        NiriConfig.apply("layout", text(fragments[behaviour] !== undefined ? behaviour : "config"));
    }

    onBehaviourChanged: apply()
    onWriterChanged: apply()
    readonly property Connections loaded: Connections {
        target: Config
        function onLoadedChanged(): void {
            root.apply();
        }
    }
    readonly property Connections result: Connections {
        target: NiriConfig
        function onApplied(name: string, ok: bool, message: string): void {
            if (name !== "layout")
                return;
            root.status = ok ? "" : message;
            if (!ok)
                console.warn("zynith: window behaviour not applied:", message);
        }
    }
}
