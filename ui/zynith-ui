#!/usr/bin/env bash
# zynith-ui start|stop|restart|status|log|build|settings [route]|ipc <method> [args...]
# Runs the Quickshell UI beside the native shell. Always the packaged Quickshell (/usr/bin), never a
# stray build earlier on PATH.
set -euo pipefail

QS=/usr/bin/quickshell
# a crash ends the process (systemd-coredump keeps the core); Quickshell's own handler would relaunch
# an untracked copy and open a report window
export QS_DISABLE_CRASH_HANDLER=1
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SHELL_QML="$HERE/shell.qml"
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/zynith"
PIDFILE="$RUN/ui.pid"
LOG="$RUN/ui.log"
NATIVE_SRC="$HERE/native"
NATIVE_BUILD="${ZYNITH_NATIVE_BUILD:-$HERE/../../build-zynith-native}"

build_native() {
    local plugin="$NATIVE_BUILD/qml/Zynith/Native/libzynith_nativeplugin.so"
    # nothing to do when the plugin is newer than every native source (keeps start fast)
    if [[ -f "$plugin" && -z "$(find "$NATIVE_SRC" -newer "$plugin" -type f -print -quit)" ]]; then
        return 0
    fi
    [[ -f "$NATIVE_BUILD/build.ninja" ]] || cmake -S "$NATIVE_SRC" -B "$NATIVE_BUILD" -G Ninja -DCMAKE_BUILD_TYPE=Release >/dev/null
    nice -n 15 cmake --build "$NATIVE_BUILD" -j 6 >/dev/null
}

running() { [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

case "${1:-status}" in
start)
    mkdir -p "$RUN"
    if running; then echo "already running ($(cat "$PIDFILE"))"; exit 0; fi
    build_native
    ZYNITH_VERSION="$(git -C "$HERE" describe --always --dirty 2>/dev/null || echo dev)" \
        QML_IMPORT_PATH="$NATIVE_BUILD/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
        setsid -f "$QS" -p "$SHELL_QML" >"$LOG" 2>&1 </dev/null
    for _ in $(seq 1 50); do
        pid=$(pgrep -n -f "^$QS -p $SHELL_QML\$" || true)
        [[ -n "$pid" ]] && { echo "$pid" >"$PIDFILE"; break; }
        sleep 0.05
    done
    echo "started ${pid:-?}"
    ;;
stop)
    if running; then
        pid=$(cat "$PIDFILE")
        kill "$pid"
        for _ in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
    fi
    rm -f "$PIDFILE"
    echo stopped
    ;;
restart) "$0" stop && "$0" start ;;
build) build_native && echo "built $NATIVE_BUILD" ;;
status) running && echo "running ($(cat "$PIDFILE"))" || echo "not running" ;;
log) sed 's/\x1b\[[0-9;]*m//g' "$LOG" ;;
settings)
    build_native
    route="${2:-home}"
    if pgrep -f "^$QS -p $HERE/settings.qml\$" >/dev/null; then
        exec "$QS" -p "$HERE/settings.qml" ipc call settings open "$route"
    fi
    ZYNITH_SETTINGS_ROUTE="$route" ZYNITH_VERSION="$(git -C "$HERE" describe --always --dirty 2>/dev/null || echo dev)" \
        QML_IMPORT_PATH="$NATIVE_BUILD/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
        setsid -f "$QS" -p "$HERE/settings.qml" >"$RUN/settings.log" 2>&1 </dev/null
    echo "settings: $route"
    ;;
ipc) shift; exec "$QS" -p "$SHELL_QML" ipc call zynith "$@" ;;
*) echo "usage: zynith-ui start|stop|restart|status|log|ipc <method> [args]" >&2; exit 2 ;;
esac
