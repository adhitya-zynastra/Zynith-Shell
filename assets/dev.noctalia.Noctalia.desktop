[Desktop Entry]
Type=Application
Name=Zynith Shell
Comment=The Zynith native shell (services, lock screen, wallpaper). Started by the Zynith session; use Zynith Settings to change it.
Exec=noctalia --daemon
Icon=noctalia
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
NoDisplay=true
Actions=Settings;
Keywords=desktop;shell;wayland;zynith;

[Desktop Action Settings]
Name=Open the native shell settings
Exec=sh -c "noctalia msg settings-open || { noctalia --daemon && noctalia msg settings-open; }"
